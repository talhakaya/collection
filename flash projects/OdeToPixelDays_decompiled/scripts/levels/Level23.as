      override public function update() : void
      {
         super.update();
         if(player.x > 160 && player.x < 480)
         {
            narratorFollow.x = player.x - 90;
            this.narratorFollow2.x = player.x - 90;
         }
         FlxG.collide(level,cheerleader);
         if(player.y > 475)
         {
            FlxG.overlap(cheerleader,machineForCheerleader,cheerleaderOverlappedWithMachine);
         }
      }
      
      override public function getWell() : void
      {
         FlxG.bgColor = 4281241856;
      }
      
      override public function nextLevel() : void
      {
         FlxG.switchState(new AnimationHans(scale,false));
      }
