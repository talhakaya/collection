      override public function update() : void
      {
         super.update();
         if(player.y > 480)
         {
            instantDeath();
         }
         if(player.x > 300 && player.x < 660)
         {
            this.lens1.x = 456 + (player.x - 488) * this.xConstant * 0.2;
            this.lens1.y = 184 + (player.y - 176) * this.yConstant * 0.2;
            this.lens2.x = 456 + (player.x - 488) * this.xConstant * 0.4;
            this.lens2.y = 184 + (player.y - 176) * this.yConstant * 0.4;
            this.lens3.x = 456 + (player.x - 488) * this.xConstant * 0.5;
            this.lens3.y = 184 + (player.y - 176) * this.yConstant * 0.5;
            this.lens4.x = 456 + (player.x - 488) * this.xConstant * 0.8;
            this.lens4.y = 184 + (player.y - 176) * this.yConstant * 0.8;
            this.lens5.x = 456 + (player.x - 488) * this.xConstant;
            this.lens5.y = 184 + (player.y - 176) * this.yConstant;
         }
         else
         {
            this.lens1.x = 1480;
            this.lens2.x = 1480;
            this.lens3.x = 1480;
            this.lens4.x = 1480;
            this.lens5.x = 1480;
         }
      }
      
      override public function getWell() : void
      {
         FlxG.bgColor = 4288900388;
      }
      
      override public function nextLevel() : void
      {
         FlxG.switchState(new AnimationHans(scale,false));
      }
      
      override public function addBgDetail() : void
      {
         bgDetails[1][1] = "bird2";
         bgDetails[2][1] = "bird";
         bgDetails[5][1] = "bird";
         bgDetails[6][1] = "bird2";
         bgDetails[3][1] = "sun00";
         bgDetails[3][2] = "sun01";
         bgDetails[4][1] = "sun10";
         bgDetails[4][2] = "sun11";
      }
   }
