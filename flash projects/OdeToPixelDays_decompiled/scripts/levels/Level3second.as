      override public function update() : void
      {
         super.update();
         if(this.timerForMonsters.complete)
         {
            this.makeMonsters();
         }
         if(this.lever.isOpen && this.tuto.alpha > 0)
         {
            this.tuto.alpha -= 0.02;
         }
      }
      
      override protected function overlapped(Sprite1:FlxSprite, Sprite2:FlxSprite) : void
      {
         super.overlapped(Sprite1,Sprite2);
         if(Sprite1 is Hans && Sprite2 is Lever && player.interact)
         {
            this.lever.used = true;
         }
      }
      
      private function makeMonsters() : void
      {
         if(!this.lever.isOpen)
         {
            if(this.count > 10)
            {
               this.count = 0;
               this.isLeft = !this.isLeft;
            }
            else
            {
               ++this.count;
            }
            monsters.add(new MonsterGelBlue(192 + Math.random() * 32,-8,scale));
            if(this.isLeft)
            {
               monsters.add(new MonsterGelBlue(144 + Math.random() * 32,-8,scale));
            }
            else
            {
               monsters.add(new MonsterGelBlue(240 + Math.random() * 32,-8,scale));
            }
            this.timerForMonsters.start(6);
         }
      }
      
      override public function interactWithDoor(Sprite2:FlxSprite) : void
      {
         if(this.lever.isOpen)
         {
            super.interactWithDoor(Sprite2);
         }
      }
      
      override public function nextLevel() : void
      {
         FlxG.switchState(new Level4());
      }
      
      override public function addBgDetail() : void
      {
         bgDetails[0][1] = "windowBig00";
         bgDetails[1][1] = "windowBig20";
         bgDetails[0][2] = "windowBig02";
         bgDetails[1][2] = "windowBig22";
      }
      
      private function selaleSfx(a:FlxTimer) : void
      {
         var volume:Number = NaN;
         if(!this.lever.isOpen)
         {
            volume = 1 - Math.abs(204 - player.x) / 240;
            this.timerForSfx.start(1,1,this.selaleSfx);
            FlxG.play(Sfx,volume);
         }
      }
   }
