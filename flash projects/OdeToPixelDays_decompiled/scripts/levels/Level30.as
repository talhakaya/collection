      override protected function cheerleaderOverlappedWithMachine(Sprite1:Cheerleader, Sprite2:Machine) : void
      {
         if(cheerleader.count > 120)
         {
            Sprite2.kill();
            timer3.start(60);
            musicFadeOut();
         }
      }
      
      override public function update() : void
      {
         super.update();
         if(this.count == 0 && !this.startedToRainBlocks && player.x > 63)
         {
            this.startedToRainBlocks = true;
         }
         if(this.startedToRainBlocks)
         {
            ++this.count;
            if(this.count == 1)
            {
               blocks.add(new BlockFalling(116,-96,scale,false,true));
            }
            else if(this.count == 15)
            {
               blocks.add(new BlockFalling(148,-96,scale,false,true));
            }
            else if(this.count > 15)
            {
               this.startedToRainBlocks = false;
            }
         }
         if(player.y > 240)
         {
            instantDeath();
         }
         if(player.fading)
         {
            cheerleader.gone = true;
         }
         FlxG.collide(level,cheerleader);
         FlxG.overlap(cheerleader,interacts,this.cheerleaderOverlappedWithMachine);
         FlxG.collide(player,blocks,blockCollision);
         FlxG.collide(level,blocks,blockParticle);
         FlxG.collide(blocks);
      }
      
