      override public function update() : void
      {
         super.update();
         if(player.x < 480 && player.x > 150)
         {
            narratorFollow.x = player.x - 100;
            narrator.x = player.x - 100;
         }
      }
      
      override protected function overlapped(Sprite1:FlxSprite, Sprite2:FlxSprite) : void
      {
         super.overlapped(Sprite1,Sprite2);
         if(Sprite1 is Hans && Sprite2 is Machine && player.interact)
         {
            narrator.erase = true;
         }
      }
      
      override public function nextLevel() : void
      {
         FlxG.switchState(new AnimationHans(scale,true));
      }
   }
