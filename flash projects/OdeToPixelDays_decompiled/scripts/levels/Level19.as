      override public function update() : void
      {
         super.update();
         FlxG.collide(level,cheerlover);
         FlxG.overlap(player,cheerlover,this.cheerloverStateChange);
         if(!cheerlover.isAttachedToHans && !cheerlover.isGoneCrazy && player.x > cheerlover.x)
         {
            this.cheerloverStateChange(player,cheerlover);
         }
         cheerlover.isOnLeftOfHans = player.x - cheerlover.x > -16;
         cheerlover.isPlayerWalkinRight = player.velocity.x > 0;
         if(player.x > 160 && player.x < 1120)
         {
            narratorFollow.x = player.x - 90;
         }
         if(player.fading)
         {
            cheerlover.fading = true;
         }
      }
      
      public function cheerloverStateChange(_p:Hans, _c:Cheerlover) : void
      {
         if(!_c.isAttachedToHans && !_c.isGoneCrazy)
         {
            narrator.erase = true;
            narrator2.erase = true;
            narratorFollow.erase = false;
            _c.firstStateChange = true;
            FlxG.playMusic(music,1);
         }
      }
      
