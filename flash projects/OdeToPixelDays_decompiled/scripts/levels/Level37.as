      override public function update() : void
      {
         super.update();
         FlxG.collide(player,blocks);
         FlxG.overlap(monsters,interacts,this.monsterHansWithDoor);
         FlxG.overlap(player,this.dikens,this.dikeneBas);
         if(player.x >= 796 && player.y > 72)
         {
            player.x = 796;
         }
      }
      
      private function dikeneBas(p:Hans, d:BlockDiken) : void
