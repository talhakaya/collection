      override public function update() : void
      {
         super.update();
         if(this.count == 0 && !this.startedToRainBlocks && player.x > 350)
         {
            this.startedToRainBlocks = true;
         }
         if(this.startedToRainBlocks)
         {
            ++this.count;
            if(this.count == 30)
            {
               blocks.add(new BlockFalling(player.x - 8,-96,scale,false,true));
            }
            else if(this.count == 120)
            {
               this.startedToRainBlocks = false;
            }
         }
         if(player.y > 480)
         {
            instantDeath();
         }
         FlxG.collide(player,blocks,blockCollision);
         FlxG.collide(level,blocks,blockParticle);
         FlxG.collide(blocks);
      }
      
      override public function getWell() : void
      {
         FlxG.bgColor = 4290199552;
      }
      
      override public function nextLevel() : void
      {
         FlxG.switchState(new Level29());
      }
   }
