      override public function update() : void
      {
         super.update();
         if(player.y > 480)
         {
            instantDeath();
         }
         else if(!narrator.erase && player.y < 280)
         {
            narrator.erase = true;
         }
         FlxG.collide(player,blocks,blockCollision);
      }
      
      override public function getWell() : void
