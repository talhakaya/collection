--- !u!114 &913212866
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 913212864}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f32b908c7c493a44ebc8d340e3033297, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  texts:
  - 'Oh my son, I know you have to go,  '
  - Darling, I missed you already!
  - My little baby came back for me.
  - Oh, welcome my darling.
  - Oh son, I'm getting older everyday.
  - My son, I'm not feeling too well.
  - My son, I'm dying.
  texts1:
  - but visit me from time to time, okay?
  - So nice of you to come and visit me.
  - I'm so proud of you.
  - I miss you every hour of every day.
  - I don't know how much I have left.
  - But I'm grateful to see you.
  - You are a good son. I'm proud of you.
  texts2:
  - Love you honey.
  - Do this often, alright?
  - You're a good child.
  - I love you more than anything.
  - But seeing you here makes me feel healthy.
  - Thank you for visiting your old lady.
  - Please, give me one last kiss.
  prefab: {fileID: 100002, guid: 6d90ea75bdb732941b61c019ba7299af, type: 3}
  yOffset: 0
  i: 0
