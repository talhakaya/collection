      override public function update() : void
      {
         super.update();
         FlxG.overlap(this.camera,this.credits,this.makeCreditVisible);
         FlxG.collide(level,cheerleader);
         ++this.count;
         if(this.count == 60)
         {
            bgObjects.add(new Cloud(player,true));
            this.count = 0;
         }
         if(player.x < 4)
         {
            player.x = 4;
         }
         else if(player.x > 164)
         {
            player.x = 164;
         }
         if(!this.gecis && player.x > 152)
         {
            this.camera.velocity.x = 30;
            FlxG.play(drama);
            this.gecis = true;
            new FlxTimer().start(22,1,this.playMusic);
         }
         if(this.fadeToBlack.alpha > 0.9)
         {
            this.fadeToBlack.alpha -= 0.0005;
         }
         else if(this.fadeToBlack.alpha > 0)
         {
            this.fadeToBlack.alpha -= 0.004;
         }
         else if(!player.moveEnable && this.fadeToBlack.alpha <= 0)
         {
            player.moveEnable = true;
         }
         if(this.camera.x > 2104)
         {
            this.nextLevel();
         }
         if(this.camera.velocity.x > 0)
         {
            if(FlxG.keys.ENTER && this.camera.velocity.x > 0)
            {
               this.camera.velocity.x = 100;
            }
            else
            {
               this.camera.velocity.x = 30;
            }
         }
      }
      
