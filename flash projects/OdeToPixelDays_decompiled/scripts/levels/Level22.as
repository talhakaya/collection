            FlxG.overlap(cheerlover,interacts,overlapped);
         }
         cheerlover.isOnLeftOfHans = player.x - cheerlover.x > 8;
         cheerlover.isPlayerWalkinRight = player.velocity.x > 0;
         if(player.x > 160 && player.x < 2400)
         {
            narratorFollow.x = player.x - 90;
         }
         if(player.fading)
         {
            cheerlover.fading = true;
         }
      }
      
      override public function getWell() : void
      {
         FlxG.bgColor = 4281241856;
      }
      
      override public function nextLevel() : void
      {
         FlxG.switchState(new Level23());
      }
   }
