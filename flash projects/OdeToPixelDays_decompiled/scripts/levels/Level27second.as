      override public function update() : void
      {
         super.update();
         if(!this.startedToRainBlocks && this.count == 0 && player.x > 44)
         {
            this.startedToRainBlocks = true;
         }
         if(this.startedToRainBlocks)
         {
            if(this.count < this.erey.length && this.erey[this.count].x < player.x - 8)
            {
               blocks.add(this.erey[this.count]);
               ++this.count;
            }
            if(this.count2 < this.erey2.length && this.erey2[this.count2].x < player.x + 168)
            {
               blocks.add(this.erey2[this.count2]);
               ++this.count2;
            }
            if(this.count3 < this.erey3.length && this.erey3[this.count3].x < player.x - 120)
            {
               blocks.add(this.erey3[this.count3]);
               ++this.count3;
            }
            if(this.count >= this.erey.length && this.count2 >= this.erey2.length && this.count3 >= this.erey3.length)
            {
               this.startedToRainBlocks = false;
            }
            for(this.i = 0; this.i < this.count; ++this.i)
            {
               if(this.erey[this.i].x < player.x - 400)
               {
                  this.erey[this.i].kill();
               }
            }
            for(this.i = 0; this.i < this.count2; ++this.i)
            {
               if(this.erey2[this.i].x < player.x - 400)
               {
                  this.erey2[this.i].kill();
               }
            }
         }
         if(player.y > 360)
         {
            instantDeath();
         }
         FlxG.collide(player,blocks,blockCollision);
         FlxG.collide(level,blocks,blockParticle);
         FlxG.collide(blocks);
      }
      
